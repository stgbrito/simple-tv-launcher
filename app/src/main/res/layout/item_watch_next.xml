<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/watchNextCardRoot"
    android:layout_width="240dp"
    android:layout_height="135dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="false">

    <!-- 16:9 Rounded Surface (240dp x 135dp, clipped to 12dp rounded corners) -->
    <FrameLayout
        android:id="@+id/watchNextTileSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_watch_next_glass">

        <!-- Poster Art via Coil with crossfade(true) -->
        <ImageView
            android:id="@+id/ivWatchNextPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Bottom subtle dark gradient scrim for progress bar & fallback title legibility -->
        <View
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_top_header_scrim"
            android:rotation="180" />

        <!-- Subtle bottom-left title overlay if poster has no text or while loading -->
        <TextView
            android:id="@+id/tvWatchNextCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="9dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#F2FFFFFF"
            android:textSize="12sp" />

        <!-- Subtle 3dp Progress Bar across the bottom edge -->
        <ProgressBar
            android:id="@+id/pbWatchNextProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_watch_next" />

    </FrameLayout>

    <!-- Crisp White/Translucent Focus Glass Outline (12dp radius) -->
    <View
        android:id="@+id/watchNextFocusBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/bg_watch_next_focus_border" />

</FrameLayout>
