<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="440dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/btn_settings"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSettingsSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:text="tvOS Launcher customization &amp; Sony Bravia system tools"
        android:textColor="@color/text_tertiary"
        android:textSize="12.5sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <!-- SECTION 1: APPS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.10"
                android:paddingStart="6dp"
                android:text="APPS"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnEditDock"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Edit Dock"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnHiddenApps"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Hidden Apps"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

            <!-- SECTION 2: APPEARANCE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.10"
                android:paddingStart="6dp"
                android:text="APPEARANCE"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnOpenWallpaper"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Wallpaper &amp; Themes"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnToggleCardLabels"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Card Text Labels: Show"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnToggleAmbientGlow"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Ambient Glow: Enabled"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnToggleContinueWatching"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Continue Watching Shelf: Disabled"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnToggleHomeLayout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Home Layout: Wallpaper Showcase (Bottom Dock)"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

            <!-- SECTION 3: CLOCK & SYSTEM TOOLS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.10"
                android:paddingStart="6dp"
                android:text="CLOCK &amp; SYSTEM TOOLS"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnToggleClockFormat"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Clock Format: 12-Hour (AM/PM)"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnTrimCache"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Free RAM &amp; Trim Cache"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnSleepTv"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Sleep TV"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnRestartTv"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Restart TV"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnOpenSystemSettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Android TV Settings"
                android:textColor="@color/selector_dialog_item_text"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
